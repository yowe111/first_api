# ── Настройки базы данных PostgreSQL ──────────────────────────────────
DB_USER=myuser
DB_PASS=mypass
DB_NAME=my_api
POSTGRES_PORT=5432

# Строка подключения к базе для нашего приложения.
# Формат: postgresql+asyncpg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД
# Хост = postgres — это имя сервиса из docker-compose.yaml.
POSTGRES_DSN=postgresql+asyncpg://myuser:mypass@postgres:5432/my_api

# ── Настройки авторизации (JWT) ───────────────────────────────────────
# Секретный ключ для подписи токенов. В реальном проекте держите его в тайне!
SECRET_KEY=super-secret-key-change-me
# Сколько минут живёт токен доступа после входа.
ACCESS_TOKEN_EXPIRE_MINUTES=60
